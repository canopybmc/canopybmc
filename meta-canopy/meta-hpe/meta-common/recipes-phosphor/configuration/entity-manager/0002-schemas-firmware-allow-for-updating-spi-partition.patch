From 0bac3524e14323ebcf19858bd36b046c2e1918aa Mon Sep 17 00:00:00 2001
From: Alexander Hansen <alexander.hansen@9elements.com>
Date: Wed, 1 Jul 2026 14:18:29 +0200
Subject: [PATCH] schemas/firmware: allow for updating spi partition

Some SPI flashes are partitioned to allow for A/B firmware updates
without requiring multiple chips.

Devicetree example:
```
   flash@1 {
    compatible = "jedec,spi-nor";
    reg = <1>;
    partitions {
     compatible = "fixed-partitions";
     #address-cells = <1>;
     #size-cells = <1>;

     host-prime@0 {
      label = "host-prime";
      reg = <0x0 0x2000000>;
     };
     host-second@2000000 {
      label = "host-second";
      reg = <0x2000000 0x2000000>;
     };
    };
   };
```

This shows up in sysfs like below:

```
root@hpe-proliant-g11:~# ls /sys/class/spi_master/spi1/spi1.1/mtd/
mtd11    mtd11ro  mtd12    mtd12ro
root@hpe-proliant-g11:~# cat /sys/class/spi_master/spi1/spi1.1/mtd/mtd11/name
host-prime
root@hpe-proliant-g11:~# cat /sys/class/spi_master/spi1/spi1.1/mtd/mtd12/name
host-second
```

Adjust the schema to allow for configuring the partition to be updated.

Tested: checked that the configuration is exposed correctly and picked
up by the code updater. Completed an update on hpe-proliant-g11.

Upstream-Status: Submitted [Gerrit, https://gerrit.openbmc.org/c/openbmc/entity-manager/+/91915]
Change-Id: Ifd0fa059d7b4b597d860bb0f9509282f6202f372
Signed-off-by: Alexander Hansen <alexander.hansen@9elements.com>
---
 configurations/hpe/dl360g11_baseboard.json | 1 +
 schemas/firmware.json                      | 6 ++++++
 2 files changed, 7 insertions(+)

diff --git a/configurations/hpe/dl360g11_baseboard.json b/configurations/hpe/dl360g11_baseboard.json
index 5de50ef4..e56ae854 100644
--- a/configurations/hpe/dl360g11_baseboard.json
+++ b/configurations/hpe/dl360g11_baseboard.json
@@ -112,6 +112,7 @@
             },
             "MuxOutputs": [],
             "Name": "UEFIPrimary",
+            "Offset": 33554432,
             "SPIControllerIndex": 1,
             "SPIDeviceIndex": 1,
             "Type": "HostSPIFlash"
diff --git a/schemas/firmware.json b/schemas/firmware.json
index c9218116..c5f118fa 100644
--- a/schemas/firmware.json
+++ b/schemas/firmware.json
@@ -102,6 +102,12 @@
                     "description": "The index of the SPI device connected to that controller",
                     "type": "number"
                 },
+                "Offset": {
+                    "description": "The start of the MTD partition to update, in bytes from the beginning of the SPI flash. Omit to use the default MTD device selection.",
+                    "type": "integer",
+                    "minimum": 0,
+                    "maximum": 18446744073709551615
+                },
                 "MuxOutputs": {
                     "$ref": "#/$defs/MuxOutputs"
                 },
