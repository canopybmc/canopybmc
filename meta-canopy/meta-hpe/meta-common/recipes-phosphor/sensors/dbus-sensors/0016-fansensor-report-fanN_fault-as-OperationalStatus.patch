From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pedro Maione <pedro.maione@9elements.com>
Date: Wed, 25 Nov 2026 22:28:28 +0100
Subject: [PATCH] fansensor: report fanN_fault as OperationalStatus

hwmon drivers report a failed fan through fanN_fault, which fansensor
ignores. psusensor already monitors these files for PSU fans.

When the fan controller provides fanN_fault for a fan's channel,
publish xyz.openbmc_project.State.Decorator.OperationalStatus on the
fan's inventory item, and update Functional from the file whenever
presence is polled. bmcweb reports Functional as the Health of the fan.
An absent fan is reported as functional, whatever the file reads.
Changes are logged with the ResourceEvent ResourceStatusChangedCritical
and ResourceStatusChangedOK messages.

Upstream-Status: Pending
---
 src/fan/FanItem.cpp |   69 +++++++++++++++++++++++++++++++++++++++++++++++++--
 src/fan/FanItem.hpp |   13 ++++++++--
 src/fan/FanMain.cpp |   26 ++++++++++++++++++-
 3 files changed, 101 insertions(+), 7 deletions(-)

diff --git a/src/fan/FanItem.cpp b/src/fan/FanItem.cpp
index be93f73..4be54fe 100644
--- a/src/fan/FanItem.cpp
+++ b/src/fan/FanItem.cpp
@@ -5,10 +5,12 @@
 
 #include <boost/asio/error.hpp>
 #include <boost/asio/io_context.hpp>
+#include <phosphor-logging/lg2.hpp>
 #include <sdbusplus/asio/object_server.hpp>
 
 #include <chrono>
 #include <filesystem>
+#include <fstream>
 #include <memory>
 #include <string>
 #include <utility>
@@ -19,8 +21,10 @@ static constexpr unsigned int pollIntervalMs = 1000;
 FanItem::FanItem(sdbusplus::asio::object_server& objectServer,
                  boost::asio::io_context& io, const std::string& name,
                  const std::string& configPath, const std::string& sensorPath,
-                 std::shared_ptr<PresenceGpio> presenceGpio) :
-    objServer(objectServer), pollTimer(io), presence(std::move(presenceGpio))
+                 std::shared_ptr<PresenceGpio> presenceGpio,
+                 const std::filesystem::path& faultPath) :
+    objServer(objectServer), pollTimer(io), presence(std::move(presenceGpio)),
+    faultPath(faultPath), name(name)
 {
     std::string path = "/xyz/openbmc_project/inventory/" + escapeName(name);
 
@@ -43,6 +47,14 @@ FanItem::FanItem(sdbusplus::asio::object_server& objectServer,
                             {"cooling", "cooled_by", boardPath},
                         });
     itemAssoc->initialize();
+
+    if (!faultPath.empty())
+    {
+        statusIface = objectServer.add_interface(
+            path, "xyz.openbmc_project.State.Decorator.OperationalStatus");
+        statusIface->register_property("Functional", functional);
+        statusIface->initialize();
+    }
 }
 
 FanItem::~FanItem()
@@ -51,6 +63,7 @@ FanItem::~FanItem()
     objServer.remove_interface(itemIface);
     objServer.remove_interface(fanIface);
     objServer.remove_interface(itemAssoc);
+    objServer.remove_interface(statusIface);
 }
 
 void FanItem::start()
@@ -60,7 +73,12 @@ void FanItem::start()
 
 void FanItem::update()
 {
-    itemIface->set_property("Present", presence->isPresent());
+    bool present = presence->isPresent();
+    itemIface->set_property("Present", present);
+    if (statusIface)
+    {
+        updateFunctional(present);
+    }
 
     std::weak_ptr<FanItem> weakRef = weak_from_this();
     pollTimer.expires_after(std::chrono::milliseconds(pollIntervalMs));
@@ -76,3 +94,48 @@ void FanItem::update()
         }
     });
 }
+
+// An absent fan is not reported as failed, whatever the controller says.
+void FanItem::updateFunctional(bool present)
+{
+    bool newFunctional = true;
+    if (present)
+    {
+        std::ifstream faultFile(faultPath);
+        int fault = 0;
+        if (!(faultFile >> fault))
+        {
+            if (!faultReadFailed)
+            {
+                lg2::error("Failed to read '{PATH}'", "PATH", faultPath);
+                faultReadFailed = true;
+            }
+            return;
+        }
+        faultReadFailed = false;
+        newFunctional = fault == 0;
+    }
+
+    if (newFunctional == functional)
+    {
+        return;
+    }
+    functional = newFunctional;
+    statusIface->set_property("Functional", functional);
+
+    if (functional)
+    {
+        lg2::info("{NAME} health status changed to OK", "NAME", name,
+                  "REDFISH_MESSAGE_ID",
+                  std::string("ResourceEvent.1.0.ResourceStatusChangedOK"),
+                  "REDFISH_MESSAGE_ARGS", name + ",OK");
+    }
+    else
+    {
+        lg2::error(
+            "{NAME} health status changed to Critical", "NAME", name,
+            "REDFISH_MESSAGE_ID",
+            std::string("ResourceEvent.1.0.ResourceStatusChangedCritical"),
+            "REDFISH_MESSAGE_ARGS", name + ",Critical");
+    }
+}
diff --git a/src/fan/FanItem.hpp b/src/fan/FanItem.hpp
