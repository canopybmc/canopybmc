 }
 
+// The hwmon fanN_fault file of fan channel @index, if the driver has one.
+static std::filesystem::path findFaultPath(
+    const std::filesystem::path& directory, size_t index)
+{
+    std::filesystem::path faultPath =
+        directory / ("fan" + std::to_string(index + 1) + "_fault");
+    std::error_code ec;
+    if (!std::filesystem::exists(faultPath, ec))
+    {
+        return {};
+    }
+    return faultPath;
+}
+
 // A fan whose Connector lists no tachometer is driven by its PWM channel
 // alone. entity-manager does not publish empty arrays, so "Tachs": [] shows up
 // as a Connector without Tachs.
@@ -659,11 +673,19 @@ static void createTachlessFans(
             {
                 continue;
             }
+            std::filesystem::path faultPath;
+            auto findIndex = findBase->second.find("Index");
+            if (findIndex != findBase->second.end())
+            {
+                faultPath = findFaultPath(
+                    directory, std::visit(VariantToUnsignedIntVisitor(),
+                                          findIndex->second));
+            }
             auto fanItem = std::make_shared<FanItem>(
                 objectServer, io, sensorName, path.str,
                 "/xyz/openbmc_project/sensors/fan_pwm/" +
                     sensor_paths::escapePathForDbus(connector->pwmName),
-                presenceGpio);
+                presenceGpio, faultPath);
             fanItem->start();
             fanItems[sensorName] = std::move(fanItem);
         }
@@ -814,7 +836,7 @@ static void createSensorsFromConfigs(
             auto fanItem = std::make_shared<FanItem>(
                 objectServer, io, sensorName, *interfacePath,
                 "/xyz/openbmc_project/sensors/fan_tach/" + tachSensor->name,
-                presenceGpio);
+                presenceGpio, findFaultPath(directory, index));
             fanItem->start();
             fanItems[sensorName] = std::move(fanItem);
         }
