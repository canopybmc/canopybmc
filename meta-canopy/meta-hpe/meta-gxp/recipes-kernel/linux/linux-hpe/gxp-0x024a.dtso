/dts-v1/;
/plugin/;
&{/} {
	model = "HPE ProLiant DL380a Gen11";
	compatible = "hpe,gxp-dl380agen11", "hpe,gxp";
};
&{/ahb@80000000} {
	kcs_conf: kcs_conf@80fc0430 {
		compatible = "hpe,gxp-kcs-bmc-cfg", "simple-mfd", "syscon";
		reg = <0x80fc0430 0x100>;
	};

	kcs_reg: kcs_reg@80fd0400 {
		compatible = "hpe,gxp-kcs-bmc";
		reg = <0x80fd0400 0x8>;
		interrupts = <6>;
		interrupt-parent = <&vic1>;
		kcs-chan = <1>;
		status = "okay";
		kcs-bmc-cfg = <&kcs_conf>;
	};

	/include/ "gxp-ubm-mux3.dtsi"
/* add PSU mux */
i2cmux@7 {
	compatible = "i2c-mux";
	i2c-parent = <&i2c7>;
	mux-controls = <&i2c_mux_ctrl 7>;
	#address-cells = <1>;
	#size-cells = <0>;
	i2c7@1 {
		reg = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
		psu1: psu@58 {
			compatible = "hpe,gxp-psu";
			reg = <0x58>;
		};
	};
	i2c7@2 {
		reg = <2>;
		#address-cells = <1>;
		#size-cells = <0>;
		psu2: psu@59 {
			compatible = "hpe,gxp-psu";
			reg = <0x59>;
		};
	};
};
syspower: syspower {
	compatible = "hpe,gxp-power";
	psu_phandle = <&psu1>, <&psu2>;
};
};
