				i2c-mux-idle-disconnect;

				i2c@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
				};
			};
		};

		i2c3@3 {
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;

			piceeprom@57 {
