				i2c-mux-idle-disconnect;

				i2c@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
				};
			};
		};

		i2c6@b {
			reg = <0x0b>;
			#address-cells = <1>;
			#size-cells = <0>;

			piceeprom@57 {
				compatible = "atmel,24c02";
				reg = <0x57>;
				vcc-supply = <&i2c_passthrough>;
