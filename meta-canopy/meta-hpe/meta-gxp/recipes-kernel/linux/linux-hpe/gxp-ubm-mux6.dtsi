				reg = <0x72>;
				#address-cells = <1>;
				#size-cells = <0>;
				vdd-supply = <&i2c_passthrough>;
				i2c-mux-idle-disconnect;

				i2c@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
				};
			};
		};

		i2c6@d {
			reg = <0x0d>;
			#address-cells = <1>;
			#size-cells = <0>;

			piceeprom@57 {
				compatible = "atmel,24c02";
				reg = <0x57>;
				vcc-supply = <&i2c_passthrough>;
			};

			ubm@40 {
				compatible = "ubm4";
				reg = <0x40>;
				vcc-supply = <&i2c_passthrough>;
			};

			switch@72 {
				compatible = "nxp,pca9543";
				reg = <0x72>;
				#address-cells = <1>;
				#size-cells = <0>;
				vdd-supply = <&i2c_passthrough>;
				i2c-mux-idle-disconnect;

				i2c@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
				};
			};
		};

		i2c6@e {
			reg = <0x0e>;
			#address-cells = <1>;
			#size-cells = <0>;

			piceeprom@57 {
				compatible = "atmel,24c02";
				reg = <0x57>;
				vcc-supply = <&i2c_passthrough>;
			};

			ubm@40 {
				compatible = "ubm4";
				reg = <0x40>;
				vcc-supply = <&i2c_passthrough>;
			};

			switch@72 {
				compatible = "nxp,pca9543";
				reg = <0x72>;
				#address-cells = <1>;
				#size-cells = <0>;
				vdd-supply = <&i2c_passthrough>;
				i2c-mux-idle-disconnect;

				i2c@0 {
					reg = <0>;
					#address-cells = <1>;
					#size-cells = <0>;
				};

				i2c@1 {
					reg = <1>;
					#address-cells = <1>;
					#size-cells = <0>;
				};
			};
		};
	};
