From e7c6a580acab563c1d71fe9ebc3126b9ed0e6558 Mon Sep 17 00:00:00 2001
From: Georg Hackel <georg.hackel@9elements.com>
Date: Wed, 19 Aug 2026 16:30:48 +0200
Subject: [PATCH] dt-bindings: media: add HPE GXP Thumbnail Video Capture
 Engine binding

Upstream-Status: Pending
Assisted-by: Claude:claude-sonnet-5
Signed-off-by: Georg Hackel <georg.hackel@9elements.com>
---
 .../media/hpe,gxp-video-thumbnail.yaml        | 40 +++++++++++++++++++
 1 file changed, 40 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/hpe,gxp-video-thumbnail.yaml

diff --git a/Documentation/devicetree/bindings/media/hpe,gxp-video-thumbnail.yaml b/Documentation/devicetree/bindings/media/hpe,gxp-video-thumbnail.yaml
new file mode 100644
index 000000000000..50a2f2d5794a
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/hpe,gxp-video-thumbnail.yaml
@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/hpe,gxp-video-thumbnail.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: HPE GXP Thumbnail Video Capture Engine
+
+maintainers:
+  - Marcello Sylvester Bauer <marcello.bauer@9elements.com>
+  - Tan Siewert <tan.siewert@9elements.com>
+
+description: |
+  The HPE GXP SoC includes a hardware engine that takes thumbnails from the
+  video engine which is in a separate IP core that isn't accessible.
+
+properties:
+  compatible:
+    const: hpe,gxp-video-thumbnail
+
+  reg:
+    maxItems: 1
+
+  hpe,bits-per-pixel:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    enum: [16, 32]
+    description: Controls the quality of the video. Defaults to 32
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    thumbnail: video@c0000500 {
+      compatible = "hpe,gxp-video-thumbnail";
+      reg = <0xc0000500 0x20>;
+      hpe,bits-per-pixel = <32>;
+    };
