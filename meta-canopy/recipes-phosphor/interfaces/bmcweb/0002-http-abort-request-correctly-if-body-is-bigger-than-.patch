+    // Once the error response for a rejected request body is complete, ask
+    // the client to stop sending the remainder of the body (RFC 9113).
+    void abortRejectedRequestBody(int32_t streamId,
+                                  const Http2StreamData& stream)
+    {
+        if (!stream.bodyRejected || ngSession.isStreamRemoteClosed(streamId))
+        {
+            return;
+        }
+        int rv = ngSession.submitRstStream(streamId, NGHTTP2_NO_ERROR);
+        if (rv != 0)
+        {
+            BMCWEB_LOG_ERROR("Failed to submit RST_STREAM: {}",
+                             nghttp2_strerror(rv));
+        }
+    }
+
     nghttp2_nv headerFromStringViews(std::string_view name,
                                      std::string_view value, uint8_t flags)
     {
@@ -305,6 +327,10 @@ class HTTP2Connection :
             close();
             return -1;
         }
+        if (it->second.bodyRejected)
+        {
+            return 0;
+        }
         auto& reqReader = it->second.reqReader;
         if (reqReader)
         {
@@ -371,30 +397,56 @@ class HTTP2Connection :
             return -1;
         }
 
-        std::optional<bmcweb::HttpBody::reader>& reqReader =
-            thisStream->second.reqReader;
+        Http2StreamData& stream = thisStream->second;
+        if (stream.bodyRejected)
+        {
+            return 0;
+        }
+
+        std::optional<bmcweb::HttpBody::reader>& reqReader = stream.reqReader;
         if (!reqReader)
         {
-            Request::Body& req = thisStream->second.req->req;
+            Request::Body& req = stream.req->req;
             reqReader.emplace(req.base(), req.body());
             boost::beast::error_code initEc;
-            reqReader->init(thisStream->second.contentLength, initEc);
+            reqReader->init(stream.contentLength, initEc);
             if (initEc)
             {
-                BMCWEB_LOG_CRITICAL("Failed to initialize payload");
-                return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE;
+                BMCWEB_LOG_ERROR("Failed to initialize payload: {}",
+                                 initEc.message());
+                return rejectRequestBody(streamId, stream, initEc);
             }
         }
         boost::beast::error_code ec;
         reqReader->put(boost::asio::const_buffer(data, len), ec);
         if (ec)
         {
-            BMCWEB_LOG_CRITICAL("Failed to write payload");
-            return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE;
+            BMCWEB_LOG_ERROR("Failed to write payload: {}", ec.message());
+            return rejectRequestBody(streamId, stream, ec);
         }
         return 0;
     }
 
+    // nghttp2 ignores non-fatal errors returned from the data chunk callback,
+    // so the stream has to be failed explicitly.
+    int rejectRequestBody(int32_t streamId, Http2StreamData& stream,
+                          const boost::beast::error_code& ec)
+    {
+        stream.bodyRejected = true;
+        stream.reqReader.reset();
+
+        Response res;
+        if (ec == boost::beast::http::error::body_limit)
+        {
+            res.result(boost::beast::http::status::payload_too_large);
+        }
+        else
+        {
+            res.result(boost::beast::http::status::bad_request);
+        }
+        return sendResponse(res, streamId);
+    }
+
     static int onDataChunkRecvStatic(
         nghttp2_session* /* session */, uint8_t flags, int32_t streamId,
         const uint8_t* data, size_t len, void* userData)
