+struct RejectingHandler
+{
+    bool called = false;
+    void handle(const std::shared_ptr<Request>& /*req*/,
+                const std::shared_ptr<bmcweb::AsyncResp>& /*asyncResp*/)
+    {
+        called = true;
+    }
+};
+
+struct FrameHeader
+{
+    boost::endian::big_uint24_buf_t length;
+    uint8_t type;
+    uint8_t flags;
+    boost::endian::big_uint32_buf_t streamId;
+};
+
+std::string makeFrame(uint8_t type, uint8_t flags, uint32_t streamId,
+                      std::string_view payload)
+{
+    FrameHeader hdr{
+        .length = boost::endian::big_uint24_buf_t(
+            static_cast<uint32_t>(payload.size())),
+        .type = type,
+        .flags = flags,
+        .streamId = boost::endian::big_uint32_buf_t(streamId),
+    };
+    std::string frame(std::bit_cast<const char*>(&hdr), sizeof(hdr));
+    frame += payload;
+    return frame;
+}
+
+std::string encodeHeaders(
+    std::initializer_list<std::pair<std::string_view, std::string_view>>
+        headers)
+{
+    std::string block;
+    for (const auto& [name, value] : headers)
+    {
+        block += '\0';
+        block += static_cast<char>(name.size());
+        block += name;
+        block += static_cast<char>(value.size());
+        block += value;
+    }
+    return block;
+}
+
+struct RejectResult
+{
+    bool handlerCalled = false;
+    std::string status;
+    std::optional<uint32_t> rstErrorCode;
+};
+
+RejectResult postToServer(std::string_view contentType,
+                          std::string_view contentLength, std::string_view body,
+                          bool endStream)
+{
+    std::string request = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";
+    request += makeFrame(NGHTTP2_SETTINGS, NGHTTP2_FLAG_NONE, 0, "");
+    request += makeFrame(
+        NGHTTP2_HEADERS, NGHTTP2_FLAG_END_HEADERS, 1,
+        encodeHeaders({{":method", "POST"},
+                       {":scheme", "http"},
+                       {":authority", "localhost"},
+                       {":path", "/redfish/v1/UpdateService/update"},
+                       {"content-type", contentType},
+                       {"content-length", contentLength}}));
+    request += makeFrame(
+        NGHTTP2_DATA, endStream ? NGHTTP2_FLAG_END_STREAM : NGHTTP2_FLAG_NONE,
+        1, body);
+
+    boost::asio::io_context io;
+    TestStream stream(io);
+    TestStream out(io);
+    stream.connect(out);
+    boost::asio::write(out, boost::asio::buffer(request));
+
+    RejectingHandler handler;
+    std::function<std::string()> date(getDateStr);
+    boost::asio::ssl::context sslCtx(boost::asio::ssl::context::tls_server);
+    auto conn = std::make_shared<HTTP2Connection<TestStream, RejectingHandler>>(
+        boost::asio::ssl::stream<TestStream>(std::move(stream), sslCtx),
+        &handler, date, HttpType::HTTP, nullptr, boost::asio::ip::address());
+    conn->start();
+    io.poll();
+
+    RejectResult result;
+    result.handlerCalled = handler.called;
+
+    std::string_view frames(out.str());
+    while (frames.size() >= sizeof(FrameHeader))
+    {
+        FrameHeader hdr{};
+        std::memcpy(&hdr, frames.data(), sizeof(hdr));
+        uint8_t type = hdr.type;
+        std::string_view payload =
+            frames.substr(sizeof(hdr), hdr.length.value());
+        frames.remove_prefix(sizeof(hdr) + payload.size());
+
+        if (type == NGHTTP2_HEADERS)
+        {
+            std::vector<std::pair<std::string, std::string>> headers;
+            unpackHeaders(payload, headers);
+            for (const auto& [name, value] : headers)
+            {
+                if (name == ":status")
+                {
+                    result.status = value;
+                }
+            }
+        }
+        else if (type == NGHTTP2_RST_STREAM &&
+                 payload.size() == sizeof(boost::endian::big_uint32_buf_t))
+        {
+            boost::endian::big_uint32_buf_t errorCode;
+            std::memcpy(&errorCode, payload.data(), sizeof(errorCode));
+            result.rstErrorCode = errorCode.value();
+        }
+    }
+    return result;
+}
+
+TEST(http_connection, RejectsBodyOverLimitEarly)
+{
+    std::string length =
+        std::to_string((1024UL * 1024UL * BMCWEB_HTTP_BODY_LIMIT) + 1);
+    RejectResult result =
+        postToServer("application/octet-stream", length, "firstchunk", false);
+
+    EXPECT_FALSE(result.handlerCalled);
+    EXPECT_EQ(result.status, "413");
+    EXPECT_EQ(result.rstErrorCode, NGHTTP2_NO_ERROR);
+}
+
+TEST(http_connection, RejectsMalformedMultipart)
+{
+    RejectResult result = postToServer("multipart/form-data; boundary=abc",
+                                       "13", "not multipart", true);
+
+    EXPECT_FALSE(result.handlerCalled);
+    EXPECT_EQ(result.status, "400");
+    EXPECT_FALSE(result.rstErrorCode);
+}
