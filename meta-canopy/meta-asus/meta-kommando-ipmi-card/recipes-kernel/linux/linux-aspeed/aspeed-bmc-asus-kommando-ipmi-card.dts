/dts-v1/;

#include "aspeed-g6.dtsi"
#include "aspeed-g6-pinctrl.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>

/ {
	compatible = "asus,ast2600-kommando-ipmi-card", "aspeed,ast2600";
	model = "Asus Kommando IPMI Expansion Card";

	aliases {
		serial4 = &uart5;
	};

	chosen {
		stdout-path = "serial4:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		led-fault {
			default-state = "off";
			gpios = <&gpio1 ASPEED_GPIO(C, 5) GPIO_ACTIVE_HIGH>;
			label = "panic_amber";
			panic-indicator;
		};

		led-heartbeat {
			gpios = <&gpio0 ASPEED_GPIO(A, 7) GPIO_ACTIVE_LOW>;
			label = "heartbeat_green";
			linux,default-trigger = "timer";
		};
	};

	reserved-memory {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		video_engine_memory: video {
			compatible = "shared-dma-pool";
			alignment = <0x01000000>;
			reusable;
			size = <0x04000000>;
		};
	};

	memory@80000000 {
		reg = <0x80000000 0x40000000>;
		device_type = "memory";
	};
};

&fmc {
	status = "okay";

	flash@0 {
		label = "bmc";
		spi-max-frequency = <50000000>;
		m25p,fast-read;

		status = "okay";
#include "openbmc-flash-layout-64.dtsi"
	};
};

&gpio0 {
	gpio-line-names =
	/*A0 0*/	"", "", "", "", "", "", "", "led-heartbeat",
	/*B0 8*/	"", "", "", "", "", "", "", "",
	/*C0 16*/	"", "", "", "", "", "", "", "",
	/*D0 24*/	"", "", "", "", "", "", "", "",
	/*E0 32*/	"", "", "", "", "", "", "", "",
	/*F0 40*/	"", "", "", "", "", "", "", "",
	/*G0 48*/	"", "", "", "", "", "", "", "",
	/*H0 56*/	"", "", "", "", "", "", "", "",
	/*I0 64*/	"", "", "", "reset-chassis-control-n", "", "", "", "",
	/*J0 72*/	"", "", "", "", "", "", "", "",
	/*K0 80*/	"", "", "", "", "", "", "", "",
	/*L0 88*/	"", "", "", "", "", "", "", "",
	/*M0 96*/	"", "", "", "", "", "", "", "",
	/*N0 104*/	"", "", "", "", "", "", "", "",
	/*O0 112*/	"", "", "", "", "", "", "", "",
	/*P0 120*/	"", "", "", "", "", "", "", "",
	/*Q0 128*/	"", "", "", "", "", "", "", "",
	/*R0 136*/	"", "", "", "", "", "", "", "",
	/*S0 144*/	"", "", "", "", "", "", "", "",
	/*T0 152*/	"", "", "", "", "", "", "", "",
	/*U0 160*/	"", "", "", "", "", "", "", "",
	/*V0 168*/	"", "", "", "", "power-chassis-control-n", "", "host0-ready", "",
	/*W0 176*/	"", "", "", "", "", "", "", "",
	/*X0 184*/	"", "bmc-init", "bmc-ready-n", "", "", "", "", "",
	/*Y0 192*/	"", "", "", "", "", "", "", "",
	/*Z0 200*/	"", "", "", "", "", "", "", "";
};

&gpio1 {
	gpio-line-names =
	/*18A0 0*/  "","","","","","","","",
	/*18B0 8*/  "","","","","","","","",
	/*18C0 16*/ "","","","","","led-fault","","",
	/*18D0 24*/ "","","","","","","","",
	/*18E0 32*/ "","","","","","","","";
};

&lpc_snoop {
	snoop-ports = <0x80>;

	status = "okay";
};

&mac2 {
	phy-handle = <&ethphy2>;
	phy-mode = "rgmii";
	pinctrl-0 = <&pinctrl_rgmii3_default>;
	pinctrl-names = "default";

	status = "okay";
};

&mdio2 {
	pinctrl-0 = <&pinctrl_mdio3_default>;
	pinctrl-names = "default";

	status = "okay";

	ethphy2: ethernet-phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0>;
	};
};

&vhub {
	status = "okay";
};

&video {
	memory-region = <&video_engine_memory>;

	status = "okay";
};
